# Supramed — Apache config para hospedagem estática (Hostinger)
# Arraste o CONTEÚDO de dist/ para o public_html/ da Hostinger.
# Cache: CSS/JS 1 ano (immutable + ?v= no build) | imagens 30 dias | HTML sempre revalida

Options -Indexes
DirectoryIndex index.html
FileETag MTime Size

# ─── HTTPS obrigatório ────────────────────────────────────────────────────────
# Passo: Hostinger → SSL → "Ativar SSL grátis" → aguardar propagação → descomentar:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ─── Redirects (equivalente ao vercel.json) ───────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.supramedsaude\.com\.br$ [NC]
  RewriteRule ^ https://supramedsaude.com.br%{REQUEST_URI} [L,R=301]
  RewriteRule ^contato/?$    /fale-conosco/ [L,R=301]
  RewriteRule ^contato\.html$ /fale-conosco/ [L,R=301]
  RewriteRule ^home/?$       /              [L,R=301]
  RewriteRule ^index\.html$  /              [L,R=301]
</IfModule>

# ─── Página 404 personalizada ─────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Compressão gzip / brotli (quando disponível) ─────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html text/css text/javascript text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml
</IfModule>

# ─── Cache-Control (equivalente ao vercel.json) ───────────────────────────────
<IfModule mod_headers.c>
  # CSS e JS — 1 ano; cache bust via ?v=BUILD_ID no HTML gerado pelo build
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens, fontes, PDF — 30 dias + revalidação em background
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico|avif|woff|woff2|ttf|otf|pdf)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML — conteúdo dinâmico; sempre buscar versão nova após deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # sitemap e robots — 1 hora
  <FilesMatch "(^sitemap\.xml$|^robots\.txt$)">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=600"
  </FilesMatch>

  # meta do build — nunca cachear (consulta de versão deployada)
  <FilesMatch "(^build-meta\.json$|^build-id\.txt$)">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                              "access plus 1 year"
  ExpiresByType application/javascript                "access plus 1 year"
  ExpiresByType image/jpeg                            "access plus 30 days"
  ExpiresByType image/png                             "access plus 30 days"
  ExpiresByType image/webp                            "access plus 30 days"
  ExpiresByType image/svg+xml                         "access plus 30 days"
  ExpiresByType image/gif                             "access plus 30 days"
  ExpiresByType image/x-icon                          "access plus 30 days"
  ExpiresByType application/pdf                       "access plus 30 days"
  ExpiresByType text/html                             "access plus 0 seconds"
  ExpiresByType application/xml                       "access plus 1 hour"
  ExpiresByType text/plain                            "access plus 1 hour"
</IfModule>

# ─── Headers de segurança ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options    "nosniff"
  Header always set X-Frame-Options           "SAMEORIGIN"
  Header always set Referrer-Policy           "strict-origin-when-cross-origin"
  Header always set Permissions-Policy        "geolocation=(), camera=(), microphone=(), payment=()"
  # HSTS — só ative DEPOIS de confirmar que HTTPS redirect acima funciona
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ─── MIME types ───────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml           .svg
  AddType image/webp              .webp
  AddType application/font-woff2  .woff2
  AddType application/font-woff   .woff
  AddType application/json        .json
</IfModule>
