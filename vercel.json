{
  "trailingSlash": true,
  "redirects": [
    { "source": "/contato", "destination": "/fale-conosco/", "permanent": true },
    { "source": "/contato/", "destination": "/fale-conosco/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*\\.(jpg|jpeg|png|svg|webp|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
